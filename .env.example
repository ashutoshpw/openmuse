# Copy this file to .env.local for local development.
DATABASE_URL=postgres://openmuse_runtime:change-me@localhost:5432/openmuse
MIGRATION_DATABASE_URL=postgres://openmuse_migrator:change-me@localhost:5432/openmuse
WORKER_DATABASE_URL=postgres://openmuse_worker:change-me@localhost:5432/openmuse
# Better Auth must use a separate role/pool (for example openmuse_auth).
AUTH_DATABASE_URL=postgres://openmuse_auth:change-me@localhost:5432/openmuse
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key
OPENMUSE_BOOTSTRAP_TOKEN=replace-with-a-one-shot-bootstrap-token
OPENMUSE_BOOTSTRAP_EMAIL=you@example.com
OPENMUSE_BOOTSTRAP_PASSWORD=replace-with-a-long-password
# Test-only worker mode; leave unset in production.
WORKER_DETERMINISTIC_MODEL=false
API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_OPENMUSE_API_URL=http://localhost:8787
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=openmuse
STORAGE_ACCESS_KEY=replace-with-a-local-storage-key
STORAGE_SECRET_KEY=replace-with-a-local-storage-secret
